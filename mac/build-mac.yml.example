# Optional CI build of the macOS app. To enable: copy this file to .github/workflows/build-mac.yml
# (pushing workflow files needs a token with the "workflow" scope: gh auth refresh -s workflow).
name: Build macOS app

on:
  workflow_dispatch:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  mac-app:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build GitHub Helper.app
        run: ./mac/build-app.sh dist
      - name: Zip (keeps the executable bit)
        run: ditto -c -k --sequesterRsrc --keepParent "dist/GitHub Helper.app" GitHub-Helper-macOS.zip
      - uses: actions/upload-artifact@v4
        with:
          name: GitHub-Helper-macOS
          path: GitHub-Helper-macOS.zip
      - name: Attach to the release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: GitHub-Helper-macOS.zip
